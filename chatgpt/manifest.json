{
  "manifest_version": 3,
  "name": "ChatGPT 静默模式 — 记录 · 点击才答",
  "version": "0.1.0",
  "description": "在 chatgpt.com 上叠加静默记录侧栏；点某条拼好上下文丢给 ChatGPT。全局快捷键把剪贴板文字/当前标签页截图发到你指定的 ChatGPT 标签页。",
  "permissions": ["storage", "clipboardWrite", "clipboardRead", "tabs", "scripting", "offscreen", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "upload_clipboard": {
      "suggested_key": { "default": "Ctrl+Shift+G", "mac": "Command+Shift+G" },
      "description": "把剪贴板文字发给目标 ChatGPT 标签页"
    },
    "screenshot": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "截当前标签页并发给目标 ChatGPT 标签页"
    }
  }
}
